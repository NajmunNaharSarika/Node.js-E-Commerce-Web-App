<nav class="nav">
      <span class="brand">
          <a href="/" style="text-decoration: none; color: white; display: flex; align-items: center; gap: 10px;">
              <i class="bi bi-gem" style="color: var(--accent-color);"></i> Imperial Crown
          </a>
      </span>

      <ul>
        <li>
            <a href="/">
                <i class="bi bi-house-door"></i> Home
            </a>
        </li>
        <li>
    <a href="/cart" style="position: relative; display: inline-flex; align-items: center;">
        <i class="bi bi-cart3"></i> Cart
        
        <span id="cart-badge" 
              style="display: @(Model.hasCartItems ? 'block' : 'none'); position: absolute; top: 0; right: -5px; width: 10px; height: 10px; background-color: red; border-radius: 50%; border: 1px solid white;">
        </span>
    </a>
</li>
        
        @if(Model.authenticated){
            <li>
                <a href="/logout" style="background-color: var(--danger-color); color: white;">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </li>
        }
        else
        {
            <li>
                <a href="/register">
                    <i class="bi bi-person-plus"></i> Register
                </a>
            </li> 
            <li>
                <a href="/login">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            </li> 
            <li>
                <a href="/admin">
                    <i class="bi bi-speedometer2"></i> Admin
                </a>
            </li> 
        }
      </ul>
</nav>
