@{
    Model.title = "Category management";
    const categories = Model.categories;
}
@section nav {
    Html.partial("_nav", {authenticated:true})
}

<style>
    /* --- 1. MODERN TOOLBAR --- */
    .toolbar-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
        margin-bottom: 25px;
        border-bottom: 1px solid #f1f5f9; 
    }

    /* --- 2. TABLE STYLING --- */
    .tbl {
        width: 100%;
        border-collapse: separate; 
        border-spacing: 0; 
    }

    .tbl th {
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #94a3b8; 
        font-weight: 600;
        padding: 15px 20px;
        border-bottom: 2px solid #f1f5f9;
        text-align: left;
        width: 30%; 
    }

    .tbl td {
        padding: 18px 20px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #334155;
        transition: background-color 0.2s;
    }

    .tbl tbody tr:hover td {
        background-color: #f8fafc; 
    }

    .tbl tbody tr:last-child td { border-bottom: none; }

    /* Category Name Style */
    .cat-name {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--secondary-color);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Subcategory Text Style */
    .sub-text {
        color: #64748b;
        font-size: 0.95rem;
        line-height: 1.6;
    }
</style>

<div style="max-width: 1100px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);">

    <div class="toolbar-container">
        <h2 class="page-title" style="margin:0; font-size:1.5rem; font-weight:700; color:var(--secondary-color);">
            Categories
        </h2>
        
        <a href="/create-category" class="btn primary" 
           style="padding: 0.5rem 1rem; font-size: 0.9rem; border-radius: 8px; display: inline-flex;margin:9px; align-items: center; gap: 8px; font-weight: 500; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2); text-decoration: none;">
            <i class="bi bi-plus-lg" style="font-weight: 900;"></i> Add Category
        </a>
    </div>

    <table class="tbl">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Subcategories</th>
            </tr>
        </thead>
        <tbody>
        @for(var i=0; i<categories.length; i++){
            <tr>
                <td>
                    <div class="cat-name">
                        <div style="width: 32px; height: 32px; background: #e0f2fe; color: var(--primary-color); border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-grid-fill" style="font-size: 0.9rem;"></i>
                        </div>
                        @categories[i].categoryname
                    </div>
                </td>
                
                <td class="sub-text">
                    @if(categories[i].subs && categories[i].subs.length > 0) {
                        <span>@categories[i].subs</span>
                    } else {
                        <span style="color: #cbd5e1; font-style: italic;">No subcategories</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

</div>